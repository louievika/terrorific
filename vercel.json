{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/assets/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
